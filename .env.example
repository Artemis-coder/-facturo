# Copiez ce fichier vers .env et renseignez vos identifiants Supabase
# (Project Settings → API dans votre tableau de bord Supabase).
# La clé "anon public" est sûre à utiliser côté client — elle est
# conçue pour ça, la sécurité réelle vient des policies RLS en base.

# URL publique de l'application (utilisée pour les liens d'invitation et redirections).
# En production, renseignez votre domaine (ex: https://votre-app.com).
# En développement, la valeur par défaut est l'origine du navigateur.
VITE_SITE_URL=https://facturo-one.vercel.app/

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=
